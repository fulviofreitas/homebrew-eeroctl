{
    "hooks": {
      "SessionStart": [
        {
          "matcher": "startup|resume|clear|compact|fork",
          "hooks": [
            {
              "type": "command",
              "command": ".claude/graphify-session-hook.sh start >/tmp/graphify-session.log 2>&1 &",
              "timeout": 10
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": ".claude/graphify-session-hook.sh end >>/tmp/graphify-session.log 2>&1 &",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
